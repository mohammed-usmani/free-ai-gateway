# Callers send: Authorization: Bearer <GATEWAY_API_KEY>. Generate one: openssl rand -hex 32
GATEWAY_API_KEY=

# Provider keys, comma-separated for rotation (<PROVIDER>_API_KEYS=k1,k2). Leave a provider
# empty to skip it everywhere. All of these have free tiers that need no card (Sep 2026).
# Keys from one account share one quota; don't create extra accounts (most terms forbid it).

# Text
GEMINI_API_KEYS=          # aistudio.google.com  (also Gemini Live voice, embeddings, TTS)
GROQ_API_KEYS=            # console.groq.com     (also Whisper STT, Orpheus TTS)
MISTRAL_API_KEYS=         # console.mistral.ai   (Experiment plan; also embeddings, Voxtral STT)
OPENROUTER_API_KEYS=      # openrouter.ai        (":free" models)
NVIDIA_NIM_API_KEYS=      # build.nvidia.com
SAMBANOVA_API_KEYS=       # cloud.sambanova.ai
ZAI_API_KEYS=             # z.ai
CLOUDFLARE_API_KEYS=      # dash.cloudflare.com → Workers AI token
CLOUDFLARE_ACCOUNT_ID=

# Voice
DEEPGRAM_API_KEYS=        # $200 signup credit (streaming STT + TTS)
ASSEMBLYAI_API_KEYS=      # $50 credit
SPEECHMATICS_API_KEYS=    # $100 credit
CARTESIA_API_KEYS=        # 20k credits/month, non-commercial
RIME_API_KEYS=
ELEVENLABS_API_KEYS=      # 10k credits/month, non-commercial, attribution

# --- Paid mode (model "paid/<alias>") -------------------------------------------------
# Separate keys, never used by free mode. Leave empty to skip; paid aliases then fall back
# to free where providers.paid.yaml says so.
PAID_ANTHROPIC_API_KEYS=
PAID_OPENAI_API_KEYS=
PAID_GEMINI_API_KEYS=     # a billing-enabled Gemini API key
PAID_DEEPGRAM_API_KEYS=
PAID_ASSEMBLYAI_API_KEYS=
PAID_CARTESIA_API_KEYS=
PAID_ELEVENLABS_API_KEYS=

# Optional
# PROVIDERS_FILE=providers.free.yaml
# PAID_PROVIDERS_FILE=providers.paid.yaml
# STATE_DB=state.db              # usage + key health
# PRICE_REFRESH_HOURS=6          # 0 = only the price table bundled with LiteLLM
# GATEWAY_SELF_URL=http://127.0.0.1:8000/v1   # where the voice cascade reaches the chat endpoint
